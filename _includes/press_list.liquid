{%- comment -%} Press list with each article's main image as the thumbnail. Optional param: limit {%- endcomment -%}
{%- assign lim = include.limit | default: 999 -%}
<style>
  .press-list { list-style: none; margin: 0 0 0.5rem; padding: 0; }
  .press-list li { display: flex; gap: 1rem; align-items: center; padding: 0.7rem 0; border-top: 1px solid var(--global-divider-color); }
  .press-list li:first-child { border-top: 0; }
  .press-list .press-thumb { flex: 0 0 auto; width: 132px; height: 80px; display: block; overflow: hidden; border: 1px solid var(--global-divider-color); border-radius: 4px; background: var(--global-card-bg-color); }
  .press-list .press-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .press-list .press-meta { min-width: 0; }
  .press-list .press-outlet { font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--global-text-color-light); margin-bottom: 1px; }
  .press-list .press-title { line-height: 1.3; }
  .press-list .press-int { color: var(--global-theme-color); font-weight: 700; }
  @media (max-width: 576px) { .press-list .press-thumb { width: 96px; height: 60px; } }
</style>
<ul class="press-list">
  {%- for p in site.data.press limit: lim -%}
  <li>
    <a class="press-thumb" href="{{ p.url }}" target="_blank" rel="noopener noreferrer">
      <img src="{{ '/assets/img/press/' | append: p.image | relative_url }}" alt="{{ p.outlet | escape }}: {{ p.title | escape }}" loading="lazy" />
    </a>
    <div class="press-meta">
      <div class="press-outlet">{% if p.interview %}<span class="press-int">(interview)</span> {% endif %}{{ p.outlet }}</div>
      <a class="press-title" href="{{ p.url }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a>
    </div>
  </li>
  {%- endfor -%}
</ul>
