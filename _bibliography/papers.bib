@article{schuetz2026openmhc,
  title={OpenMHC: Accelerating the Science of Wearable Foundation Models},
  author={Schuetz, Narayan and Bai, Yuze and Pan, Lianggang and Eggert, Edgar and Nerrise, Favour and Delgado-SanMartin, Juan and Rosenblattl, Max and Gurbanova, Milana and Asadi, Mohammad and Johnson, Anders and Schmiedmayer, Paul and Wang, Dennis and Lawrie, Allan and Kim, Daniel Seung and Liu, Xin and Paruchuri, Akshay and Adeli, Ehsan and Ashley, Euan A. and Zhang, Kelly W.},
  journal={arXiv preprint},
  year={2026},
  selected={true},
  preview={openmhc.png},
  arxiv={2607.16235},
  code={https://github.com/AshleyLab/OpenMHC},
  website={https://myheartcounts.stanford.edu/openmhc},
  abstract={OpenMyHeartCounts (OpenMHC) is the largest and most comprehensive open-access wearable health dataset released to date, published alongside open-source implementations of recent wearable foundation models. Derived from over a decade of data collected through the My Heart Counts study app, it includes more than 60 million hours of wearable data across 19 sensor channels and 169 linked variables from 11,894 consenting participants. A unified open benchmark enables standardized comparison of wearable health models across downstream prediction, multivariate data imputation, and time-series forecasting.}
}

@article{abbasi2026neuroqa,
  title={NeuroQA: A Large-Scale Image-Grounded Benchmark for 3D Brain MRI Understanding},
  author={Abbasi*, Mohammad H. and Nerrise*, Favour and Ghosh, Shaurnav and Yesiloglu, Ridvan and Mao, Yuncong and Trang, Bailey and Asadi, Mohammad and Daniel, Merryn and {Chau Loo Kung}, Gustavo and Chang, Ken and Shah, Pavan Pinkesh and Turnbull, Adam and Younes, Kyan and Dehkharghani, Seena and Adeli, Ehsan},
  journal={arXiv preprint},
  year={2026},
  selected={true},
  preview={neuroqa.png},
  arxiv={2605.20525},
  website={https://neuroqa.stanford.edu},
  abstract={NeuroQA is a large-scale benchmark for visual question answering in 3D brain MRI, with 56,953 question-answer pairs from 12,977 subjects across 12 datasets. It spans ages 5 to 104 and five clinical domains: Alzheimer's disease, Parkinson's disease, tumors, white matter disease, and neurodevelopment. Unlike prior medical VQA efforts that operate on 2D slices or rely on narrow diagnostic labels, NeuroQA pairs every item with a full 3D volume and evaluates 11 clinically grounded reasoning skills across yes/no, multiple-choice, and open-ended formats.}
}

